{
  "name": "esp32-smart-home-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:mobile": "pnpm --filter mobile_app start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "validate:contract": "turbo run validate:contract",
    "check:all": "turbo run lint test validate:contract"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.5.0"
  }
}
