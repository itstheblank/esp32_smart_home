{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.test.ts",
        "src/**/*.js"
      ]
    },
    "lint": {},
    "validate:contract": {},
    "format:check": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
