#!/bin/sh
# pre-commit: run quality checks on mobile_app if staged

if git diff --cached --name-only | grep -q "^mobile_app/"; then
  echo "⏳ Running mobile_app quality checks (format & contract)..."
  cd mobile_app && npm run format:check && npm run validate:contract
  STATUS=$?
  cd ..
  if [ $STATUS -ne 0 ]; then
    echo "❌ Quality check failed in mobile_app. Fix issues before committing."
    exit 1
  fi
fi

echo "✅ Pre-commit checks passed."

